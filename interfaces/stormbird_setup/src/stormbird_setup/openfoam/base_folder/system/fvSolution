FoamFile
{
	version 2.0;
	format ascii;
	class dictionary;
	object fvSolution;
	location "system";
}

solvers
{
	p
	{
		solver GAMG;
		smoother DIC;
		tolerance 1e-08;
		relTol 0.01;
		minIter 1;
	}

	pFinal
	{
		$p;
		relTol 0;
	}

	U
	{
		solver smoothSolver;
		smoother GaussSeidel;
		tolerance 1e-09;
		relTol 0.001;
		minIter 3;
	}

	k
	{
		solver smoothSolver;
		smoother GaussSeidel;
		tolerance 1e-08;
		relTol 0.01;
		minIter 3;
	}

	omega
	{
		solver smoothSolver;
		smoother GaussSeidel;
		tolerance 1e-08;
		relTol 0.01;
		minIter 3;
	}

	"(U|k|omega)Final"
	{
		$U;
		relTol 0;
	}
}

SIMPLE
{
	nNonOrthogonalCorrectors 1;
	consistent true;
	residualControl
	{
		p 1e-06;
		U 1e-07;
	}

}

PIMPLE
{
	nOuterCorrectors 1;
	nCorrectors 2;
	nNonOrthogonalCorrectors 1;
}

relaxationFactors
{
	fields
	{
		p 0.9;
		pFinal 1;
	}

	equations
	{
		U 0.9;
		k 0.7;
		omega 0.7;
		"(U|k|omega)Final" 1;
	}

}

cache
{
	grad(U) ;
}

