/*
 * -Wno-overloaded-virtual: silences a warning from the OpenFOAM header coupledPointPatchField.H,
 * triggered by interpolationCellPoint<vector> in sampling.cpp. It is not an issue in this code.
 */
EXE_INC = \
    -Wno-overloaded-virtual \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/fvOptions/lnInclude

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -lfvOptions \
    -L../rust_build -lcpp_actuator_line
